# Sao chep file nay thanh ".env" (khong co ".example") va dien gia tri that vao.
# File .env sẽ KHONG bao gio duoc commit len git (da khai bao trong .gitignore).

# Private token lay tu Haravan Admin > Apps > Private app > Create new private app
HARAVAN_PRIVATE_TOKEN=

# Thuong khong can doi, giu nguyen gia tri mac dinh nay
HARAVAN_API_BASE=https://apis.haravan.com/com

# Mat khau tu dat de xem danh sach lead khach si tai /admin/leads?key=...
# Tu nghi mot chuoi bat ky, cang dai cang kho doan (vd: mot cau dai khong dau).
ADMIN_KEY=

# Connection string Postgres (vd tu Supabase - xem README muc "Luu lead vao database that").
# Neu de trong: app van chay binh thuong nhung tu dong fallback ve file data/leads.json
# (khong ben vung tren Render free - mat khi build lai).
DATABASE_URL=

# App ID + Secret Key lay tu app ban tao tren developers.zalo.me, gan vao Official Account
# cua ban (xem README muc "Noi Zalo OA that"). De trong thi notifyNewLead chi log console.
ZALO_APP_ID=
ZALO_APP_SECRET=

# user_id Zalo cua nguoi se nhan thong bao lead moi (thuong la sale/admin) - nguoi nay PHAI
# da tung nhan tin cho OA it nhat 1 lan truoc. Xem README de biet cach lay user_id.
ZALO_NOTIFY_USER_ID=
